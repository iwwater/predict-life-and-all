# ---------- Stage 1: build with full toolchain ----------
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# System deps: build tools for any wheel that needs compiling
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# Layer 1: deps only
COPY pyproject.toml ./
# `uv` would be nicer, but we stick to pip for fewer moving parts in Docker
RUN pip install --upgrade pip \
    && pip install \
        "lunar-python>=1.4.0" \
        "py-iztro>=0.1.5" \
        "kinqimen>=0.1.0" \
        "skyfield>=1.48" \
        "skyfield-data>=7.0.0" \
        "jplephem>=2.21" \
        "fastapi>=0.110" \
        "uvicorn[standard]>=0.27" \
        "pydantic>=2.6" \
        "python-multipart>=0.0.9" \
        "httpx>=0.27"

# de421.bsp 是 16.8MB 的 JPL 星历,仓库里不入库(.gitignore: *.bsp)。
# 在构建阶段下载一次并随镜像带走,这样全新 clone 也能 build, 且运行时无需联网。
RUN python -c "from skyfield.api import load; eph = load('de421.bsp'); print('ephemeris ready:', eph)"

# ---------- Stage 2: minimal runtime ----------
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

WORKDIR /app

# Copy installed site-packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 星历随镜像带走(构建阶段已下载到 /root/.skyfield),运行时不必联网。
COPY --from=builder /root/.skyfield /root/.skyfield

ENV SKYFIELD_PATH=/root/.skyfield

# Copy app code
COPY divination/ /app/divination/
COPY server/     /app/server/
COPY skyfield_data/ /app/skyfield_data/

EXPOSE 8000

# Use the pre-baked ephemeris, fall back to cwd lookup
ENV PYTHONPATH=/app

CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000"]
